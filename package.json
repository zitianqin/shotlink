    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@vercel/blob": "^0.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
